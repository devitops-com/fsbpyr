// The test layers of fsbpyr v0.27.0: which make target runs each (left), the test
// directories and tools/vm-smoke.py (middle), and what each exercises (right). Colours on the
// right follow the wiki's legend: build time (blue), run time inside a built executable
// (orange), external inputs (purple). Make targets and test directories are neutral (grey,
// white). make test-el8 is make test-el8-stub and make test-el8-portability; the dashed edges
// run in the EL8 test mode (FSBPYR_TEST_GLIBC=2.28).
digraph testing_layers {
  graph [fontname="Helvetica" fontsize=11 rankdir=LR bgcolor="white" pad=0.3 nodesep=0.35 ranksep=0.5];
  node [fontname="Helvetica" fontsize=10 shape=box style="rounded,filled" fillcolor="#eef3fb" color="#4a6fa5"];
  edge [fontname="Helvetica" fontsize=9 color="#555555"];

  subgraph cluster_make {
    label="make targets"; color="#bbbbbb"; style="rounded"; fontsize=10;
    node [style="filled" fillcolor="#f4f4f4" color="#888888"];
    test_ci [label="make test-ci"];
    test [label="make test"];
    test_container [label="make test-container"];
    test_corpus [label="make test-corpus"];
    test_portability [label="make test-portability"];
    test_el8_stub [label="make test-el8-stub"];
    test_el8_portability [label="make test-el8-portability"];
    test_vm [label="make test-vm"];
  }

  subgraph cluster_tests {
    label="tests/, tools/"; color="#bbbbbb"; style="rounded"; fontsize=10;
    node [fillcolor="#ffffff" color="#888888"];
    unit [label="tests/unit\nboot, builder, payload,\nruntime, top level"];
    integration [label="tests/integration"];
    e2e [label="tests/e2e\n(but corpus, portability)"];
    el8_files [label="tests/e2e: 16 files that\nrun the stub, and\ntests/unit/test_test_modes.py"];
    el8_test [label="tests/e2e/test_el8.py"];
    probes [label="tests/probes, tests/fuzz\n(built by e2e tests)"];
    portability [label="tests/e2e/\ntest_portability.py\n(skips without podman)"];
    corpus [label="tests/e2e/test_corpus.py\ntests/corpus/<app>"];
    vmsmoke [label="tools/vm-smoke.py\n(no pytest)"];
  }

  python [label="builder, payload, runtime\n(Python, in-process)"];
  boot [label="boot code in-process\n(_fsbpyr stand-in)" fillcolor="#fdf1e3" color="#c77d2a"];
  scripts [label="install.sh, release, watch\nscripts and workflow steps" fillcolor="#ffffff" color="#888888"];
  pbs [label="pinned PBS\ndistribution" fillcolor="#f3eefb" color="#7a5aa5"];
  launcher [label="launcher C code\n(probe programs, libFuzzer)" fillcolor="#fdf1e3" color="#c77d2a"];
  executables [label="built executables\n(release + ASan/UBSan launcher)" fillcolor="#fdf1e3" color="#c77d2a"];
  el8_executables [label="executables with the\nglibc 2.28 stub" fillcolor="#fdf1e3" color="#c77d2a"];
  el8_sysroot [label="pinned Rocky Linux 8.10\nRPMs (EL8 sysroot)" fillcolor="#f3eefb" color="#7a5aa5"];
  distributions [label="executables in older\ndistributions (podman)" fillcolor="#fdf1e3" color="#c77d2a"];
  el8_images [label="rockylinux:8,\nalmalinux:8 (podman)" fillcolor="#fdf1e3" color="#c77d2a"];
  apps [label="real apps and PyPI wheels\nagainst their venv" fillcolor="#f3eefb" color="#7a5aa5"];
  vm [label="aarch64 apps in a QEMU VM\n(64 KiB pages)" fillcolor="#fdf1e3" color="#c77d2a"];
  kernels [label="pinned kernel and\nroot file systems" fillcolor="#f3eefb" color="#7a5aa5"];

  test_ci -> unit;
  test_ci -> integration;
  test_ci -> e2e [label="13 files,\nrelease launcher"];
  test -> unit;
  test -> integration;
  test -> e2e;
  test -> probes;
  test -> portability;
  test_container -> unit;
  test_container -> integration;
  test_container -> e2e;
  test_container -> probes;
  test_corpus -> corpus;
  test_portability -> portability;
  test_el8_stub -> el8_files [style=dashed];
  test_el8_stub -> el8_test;
  test_el8_portability -> portability [style=dashed];
  test_vm -> vmsmoke;

  unit -> python;
  unit -> boot;
  integration -> python;
  integration -> pbs;
  integration -> scripts;
  integration -> launcher;
  e2e -> python;
  e2e -> executables;
  e2e -> el8_executables;
  el8_files -> el8_executables;
  el8_test -> executables;
  el8_test -> el8_executables;
  el8_executables -> el8_sysroot [label="stub linked\nagainst"];
  probes -> launcher;
  portability -> distributions;
  portability -> el8_images;
  corpus -> apps;
  vmsmoke -> vm;
  vmsmoke -> kernels;
}
