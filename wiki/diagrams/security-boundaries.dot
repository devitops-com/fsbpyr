// Trust boundaries of fsbpyr v0.27.0 and where each check runs. Numbers in brackets are the
// checks the Dev-Security page lists under "Where each check happens".
digraph security_boundaries {
  graph [fontname="Helvetica" fontsize=11 rankdir=TB bgcolor="white" pad=0.3 nodesep=0.35 ranksep=0.5];
  node [fontname="Helvetica" fontsize=10 shape=box style="rounded,filled" fillcolor="#eef3fb" color="#4a6fa5"];
  edge [fontname="Helvetica" fontsize=9 color="#555555"];

  subgraph cluster_inputs {
    label="External inputs"; style="rounded,dashed"; color="#7a5aa5"; fontcolor="#7a5aa5";
    index [label="package index\n(wheels, sdists)" fillcolor="#f3eefb" color="#7a5aa5"];
    uv [label="uv on PATH" fillcolor="#f3eefb" color="#7a5aa5"];
    pbs [label="python-build-standalone\narchive" fillcolor="#f3eefb" color="#7a5aa5"];
    sysroot [label="sysroot packages\n(Debian 12; Rocky Linux 8.10\nfor glibc 2.28)" fillcolor="#f3eefb" color="#7a5aa5"];
    companion [label="companion release el8-vX.Y.Z\n(glibc 2.28 stubs,\nSHA256SUMS-glibc2.28)" fillcolor="#f3eefb" color="#7a5aa5"];
  }

  subgraph cluster_build {
    label="Developer's build machine"; style="rounded"; color="#4a6fa5"; fontcolor="#4a6fa5";
    project [label="project tree\n(sources, lock, venv)" fillcolor="#eaf5ea" color="#3d8b3d"];
    runtime_build [label="fsbpyr runtime build"];
    runtime [label="runtime in fsbpyr's cache\n(stub, stdlib, runtime.json)" fillcolor="#eaf5ea" color="#3d8b3d"];
    staging [label="staging install\n(uv, from the lock)"];
    build [label="fsbpyr build"];
    el8stub [label="glibc 2.28 stub beside fsbpyr\nor in its downloads/" fillcolor="#eaf5ea" color="#3d8b3d"];
  }

  subgraph cluster_transit {
    label="In transit"; style="rounded,dashed"; color="#555555"; fontcolor="#555555";
    shipped [label="executable\n(digest in its trailer)" fillcolor="#eaf5ea" color="#3d8b3d"];
  }

  subgraph cluster_target {
    label="Target machine"; style="rounded"; color="#c77d2a"; fontcolor="#c77d2a";
    exe [label="executable file" fillcolor="#eaf5ea" color="#3d8b3d"];
    launcher [label="launcher\n(every start)" fillcolor="#fdf1e3" color="#c77d2a"];
    boot [label="boot code,\n_fsbpyr.sync" fillcolor="#fdf1e3" color="#c77d2a"];
    cache [label="per-user cache\n(extracted natives)" fillcolor="#eaf5ea" color="#3d8b3d"];
    slots [label="slot file\nfsbpyr-<euid>" fillcolor="#eaf5ea" color="#3d8b3d"];
    beside [label="files beside\nthe executable" fillcolor="#eaf5ea" color="#3d8b3d"];
    linkdir [label="link directory\n(FSBPYR_INSTALL_LINKS)" fillcolor="#eaf5ea" color="#3d8b3d"];
    caller [label="caller with\nmultiprocessing, -m, -c args" fillcolor="#fdf1e3" color="#c77d2a"];
    others [label="other local users" style="rounded,dashed" fillcolor="white" color="#555555"];
  }

  pbs -> runtime_build [label="[1] pinned SHA-256"];
  sysroot -> runtime_build [label="[1] pinned SHA-256"];
  companion -> el8stub [label="[13] listed SHA-256,\nruntime id; kept"];
  el8stub -> build [label="[13] runtime id"];
  runtime_build -> runtime [label="[2] digests recorded"];
  runtime -> build [label="[2] digests checked"];
  index -> staging [label="[3]"];
  uv -> staging [label="runs"];
  project -> staging [label="[10] without a build\nsystem: no script runs"];
  staging -> build;
  build -> shipped [label="[4] whole-file digest"];
  shipped -> exe [label="[5] attestation,\nSHA-256, inspect --verify"];
  exe -> launcher [label="[6] digest, AT_SECURE"];
  launcher -> slots [label="[8]"];
  launcher -> boot;
  boot -> cache [label="[7] way, owner, digest"];
  boot -> beside [label="[11] data only;\ncode from the payload"];
  boot -> linkdir [label="[12] symlinks only,\nnothing replaced"];
  caller -> boot [label="[9] arguments: parent check"];
  others -> cache [label="refused if they\ncan write it" style=dashed];
  others -> slots [label="a file of theirs\nis passed over" style=dashed];
}
